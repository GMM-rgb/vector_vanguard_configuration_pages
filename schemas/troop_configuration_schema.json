{
  "type": "object",
  "properties": {
    "troops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "id": { "type": "string" },
          "configuration": {
            "type": "object",
            "properties": {
              "damage": { "type": "number", "minimum": 0 },
              "cost": { "type": "integer", "minimum": 100 },
              "range": { "type": "number", "minium": 1 },
              "upgradeSequence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "level": { "type": "integer", "minimum": 1 },
                    "damage": { "type": "number", "minimum": 0 },
                    "upgradeCost": { "type": "integer", "minimum": 0 }
                  },
                  "required": ["level", "damage", "upgradeCost"]
                }
              }
            },
            "required": ["damage", "cost"]
          }
        },
        "required": ["name", "id", "configuration"]
      }
    }
  },
  "required": ["troops"]
}
